# Merge Queue config.
# Leave GitHub blank to run in MOCK MODE (fake PRs).
# Fill these in to go live against real data.

# --- Access gate (optional) ---
MQ_ACCESS_TOKENS=

# --- GitHub ---
# Optional: falls back to `gh auth token` if blank.
GITHUB_TOKEN=
GITHUB_REPOS=Slashy-com/slashyemail,Slashy-com/slashy-backend
GITHUB_MERGE_METHOD=squash
GITHUB_WEBHOOK_SECRET=
# Note: max open PRs and the 7-day activity window are product rules in
# src/lib/config.ts (maxPrs=50, maxPrAgeDays=7), not env knobs.
REQUIRE_GREEN_CI=true
BLOCKING_BOTS=cursor[bot],bugbot[bot],coderabbitai[bot]

# --- Linear ---
LINEAR_API_KEY=

# --- Email resolver: Supabase (from slashy-backend) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_USERS_TABLE=users
SUPABASE_EMAIL_COLUMN=email

# --- Email resolver: PostHog (personal key required for /persons) ---
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
