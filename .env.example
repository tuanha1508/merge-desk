# Merge Desk config.
# Leave GitHub blank to run in MOCK MODE (fake PRs).
# Copy to .env.local and fill in to go live against real data.

# --- Sign-in (required in production) ---
MQ_PASSWORD=
# Optional machine tokens for scripts (header: x-mq-token)
MQ_ACCESS_TOKENS=

# --- GitHub ---
# Optional locally: falls back to `gh auth token` if blank.
# Required on Vercel - there is no gh binary in production.
GITHUB_TOKEN=
GITHUB_REPOS=Slashy-com/slashyemail,Slashy-com/slashy-backend
GITHUB_MERGE_METHOD=squash
REQUIRE_GREEN_CI=true
BLOCKING_BOTS=

# --- Linear ---
LINEAR_API_KEY=

# --- Email resolver: Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_USERS_TABLE=users
SUPABASE_EMAIL_COLUMN=email

# --- Email resolver: PostHog (personal key required for /persons) ---
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# --- Boss updates + screenshot contact extraction ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Our own identity (never treated as the customer) ---
OWN_EMAIL_DOMAINS=slashy.com,slashy.ai
OWN_COMPANY_NAMES=Slashy

# --- Slack (optional — see SLACK.md) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
SLACK_TARGET_USER_ID=
SLACK_MERGE_USER_IDS=
SLACK_PUBLISH_SECRET=
