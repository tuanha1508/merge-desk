# Merge Desk config.
# Leave GitHub blank to run in MOCK MODE (fake PRs).
# Copy to .env.local and fill in to go live against real data.

# --- Sign-in (required in production) ---
MQ_PASSWORD=
# Optional machine tokens for scripts (header: x-mq-token)
MQ_ACCESS_TOKENS=

# --- GitHub ---
# Optional locally: falls back to `gh auth token` if blank.
# Required on Vercel - there is no gh binary in production.
GITHUB_TOKEN=
GITHUB_REPOS=your-org/your-repo,your-org/another-repo
GITHUB_MERGE_METHOD=squash
# Shared with the GitHub webhook Secret field (must match exactly).
GITHUB_WEBHOOK_SECRET=
# Note: max open PRs and the 7-day activity window are product rules in
# src/lib/config.ts (maxPrs=50, maxPrAgeDays=7), not env knobs.
REQUIRE_GREEN_CI=true
BLOCKING_BOTS=

# --- Linear ---
LINEAR_API_KEY=

# --- Email resolver: Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_USERS_TABLE=users
SUPABASE_EMAIL_COLUMN=email
# Durable Merge Desk cache tables. Defaults match the included Supabase
# migration; override only if those names conflict in your project.
MERGE_DESK_QUEUE_TABLE=merge_desk_queue_items
MERGE_DESK_SUMMARY_TABLE=merge_desk_summaries
MERGE_DESK_STATE_TABLE=merge_desk_state

# --- Live updates: Supabase Realtime (optional) ---
# When set, the board subscribes to a broadcast channel and refreshes the
# instant a webhook patches the queue, instead of waiting for the next poll.
# The anon key is safe to expose to the browser; the ping carries no PR data.
# Leave blank to fall back to polling only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Email resolver: PostHog (personal key required for /persons) ---
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# --- Boss updates + screenshot contact extraction ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Our own identity (never treated as the customer) ---
# Your company's domains and names, so teammates in a thread are never
# mistaken for the customer being helped.
OWN_EMAIL_DOMAINS=your-company.com
OWN_COMPANY_NAMES=Your Company

# --- Slack (optional — see SLACK.md) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
SLACK_TARGET_USER_ID=
SLACK_MERGE_USER_IDS=
SLACK_PUBLISH_SECRET=
